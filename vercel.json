{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"env": {
		"NODE_OPTIONS": "--experimental-require-module"
	},
	"buildCommand": "node scripts/fetch-build-history.mjs && pnpm build",
	"git": {
		"deploymentEnabled": {
			"main": false,
			"l10n_*": false,
			"release-please--*": false
		}
	}
}
